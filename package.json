{
  "name": "expense-approval-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Expense submission and approval application.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "tsx src/api/start.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --config vitest.unit.config.mts --coverage --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.mts --coverage",
    "test:coverage": "npm run test:unit && npm run test:integration:coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}

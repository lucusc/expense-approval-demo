{
  "name": "expense-approval-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Expense submission and approval application.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "tsx src/api/start.ts",
    "test": "npm run typecheck && npm run test:smoke && npm run test:unit && npm run test:integration && npm run test:ui && npm run test:e2e",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:unit": "vitest run --config vitest.unit.config.mts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.mts --coverage",
    "test:ui": "vitest run --config vitest.ui.config.mts",
    "test:coverage": "npm run test:unit && npm run test:integration:coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/express": "4.17.25",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
